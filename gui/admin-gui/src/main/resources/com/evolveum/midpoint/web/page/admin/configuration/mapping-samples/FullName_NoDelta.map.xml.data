<mapping>
	<strength>weak</strength>
	<source>
		<path>givenName</path>
	</source>
	<source>
		<path>familyName</path>
	</source>
	<expression>
		<script>
		    <language>mel</language>
			<code>
				givenName + ' ' + familyName
			</code>
		</script>
	</expression>
	<target>
		<path>fullName</path>
	</target>
</mapping>
