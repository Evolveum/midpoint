<archetype oid="00000000-0000-0000-0000-000000000523"
        xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
        xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
        xmlns:mext="http://midpoint.evolveum.com/xml/ns/public/model/extension-3">
    <name>Shadow reclassification task</name>
    <archetypePolicy>
        <display>
            <label>
                <orig>Shadow reclassification task</orig>
                <translation>
                    <key>ShadowReclassificationTask.label</key>
                </translation>
            </label>
            <pluralLabel>
                <orig>Shadow reclassification tasks</orig>
                <translation>
                    <key>ShadowReclassificationTasks.title</key>
                </translation>
            </pluralLabel>
            <icon>
                <cssClass>fa fa-refresh</cssClass>
                <color>green</color>
            </icon>
        </display>
        <itemConstraint id="1">
            <path>extension</path>
            <visibility>vacant</visibility>
        </itemConstraint>
        <adminGuiConfiguration>
            <objectDetails>
                <type>TaskType</type>
                <panel id="2">
                    <identifier>activity</identifier>
                    <panel id="3">
                        <identifier>work</identifier>
                        <container id="4">
                            <identifier>work-import</identifier>
                            <path>activity/work/shadowReclassification</path>
                        </container>
                    </panel>
                </panel>
            </objectDetails>
        </adminGuiConfiguration>
    </archetypePolicy>
    <assignment id="5">
        <identifier>holderType</identifier>
        <assignmentRelation id="6">
            <holderType>TaskType</holderType>
        </assignmentRelation>
    </assignment>
    <inducement id="7">
        <identifier>nameMapping</identifier>
        <focusMappings>
            <mapping id="8">
                <strength>weak</strength>
                <source>
                    <path>$source/name</path>
                    <name>archetypeName</name>
                </source>
                <expression>
                    <script>
                        <language>http://midpoint.evolveum.com/xml/ns/public/expression/language#mel</language>
                        <code>midpoint.getDefaultNameForResourceRelatedTask(stringify(archetypeName), focus.activity.work.shadowReclassification.resourceObjects)</code>
                    </script>
                </expression>
                <target>
                    <path>name</path>
                </target>
            </mapping>
        </focusMappings>
    </inducement>
</archetype>
