<report xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
        xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
        xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
        oid="00000000-0000-0000-0000-b8249b79d2b5">
    <name>IGA: Who has access to what and why</name>
    <description>Displays IGA representation of user access - all roles, ORGs and services (applications) assigned to users directly or indirectly.
        Formerly known as Indirect assignment report.</description>
    <assignment id="1">
        <identifier>archetype</identifier>
        <targetRef oid="00000000-0000-0000-0000-000000000171" type="ArchetypeType"/>
    </assignment>
    <objectCollection>
        <collection>
            <!-- Type is declared in the view element. -->
            <filter>
                <q:text>
                    . ownedBy (
                        @type = UserType
                        and @path = roleMembershipRef
                        and name = yaml```
                            queryInterpretationOfNoValue: filterAll
                            path: $userName
                        ```
                    ) and . = yaml```
                        queryInterpretationOfNoValue: filterAll
                        path: $roleRef
                    ```
                </q:text>
            </filter>
        </collection>
        <parameter id="2">
            <name>userName</name>
            <type>string</type>
        </parameter>
        <parameter id="3">
            <name>roleRef</name>
            <type>c:ObjectReferenceType</type>
            <targetType>c:AbstractRoleType</targetType>
        </parameter>

        <subreport id="4">
            <!--
            This subreport generates additional lines per each metadata value,
            in case there are multiple distinct assignment paths.
            -->
            <name>data</name>
            <order>1</order>
            <resultHandling>
                <multipleValues>splitParentRow</multipleValues>
            </resultHandling>
            <expression>
                <script>
                    <language>http://midpoint.evolveum.com/xml/ns/public/expression/language#mel</language>
                    <objectVariableMode>prismReference</objectVariableMode>
                    <code>
                        object.valueMetadata().filter(metadata,
                            isPresent(metadata.provenance) &amp;&amp;
                            isPresent(metadata.provenance.assignmentPath))
                    </code>
                </script>
            </expression>
        </subreport>
        <view>
            <type>c:ObjectReferenceType</type>
            <paging>
                <q:orderBy>../name</q:orderBy>
            </paging>
            <!--
            IMPORTANT:
            All the scripts must use objectVariableMode=prismReference for the case the target does not exist.
            -->
            <column id="5">
                <name>user</name>
                <display>
                    <label>
                        <orig>User</orig>
                        <translation>
                            <key>reportIndirectAssignments.userColumn.label</key>
                        </translation>
                    </label>
                </display>
                <export>
                    <expression>
                        <script>
                            <language>http://midpoint.evolveum.com/xml/ns/public/expression/language#mel</language>
                            <objectVariableMode>prismReference</objectVariableMode>
                            <code>
                                !isPresent(data) ? 'Unknown owner' : cel.bind(owner,
                                        midpoint.resolveReferenceIfExists(
                                            data.provenance.assignmentPath.sourceRef),
                                        isPresent(owner) &amp;&amp; isPresent(owner.name) &amp;&amp;
                                        isPresent(owner.name.orig) &amp;&amp; owner.name.orig != ''
                                            ? owner.name.orig : 'Unknown owner')
                            </code>
                        </script>
                    </expression>
                </export>
            </column>
            <column id="6">
                <name>nameColumn</name>
                <display>
                    <label>
                        <orig>Name</orig>
                        <translation>
                            <key>reportIndirectAssignments.nameColumn.label</key>
                        </translation>
                    </label>
                </display>
                <previousColumn>user</previousColumn>
                <export>
                    <expression>
                        <script>
                            <language>http://midpoint.evolveum.com/xml/ns/public/expression/language#mel</language>
                            <objectVariableMode>prismReference</objectVariableMode>
                            <code>
                                cel.bind(role, midpoint.resolveReferenceIfExists(object),
                                    isPresent(role) &amp;&amp; isPresent(role.name)
                                        ? role.name.orig : nil)
                            </code>
                        </script>
                    </expression>
                </export>
            </column>
            <column id="7">
                <name>archetypeName</name>
                <display>
                    <label>
                        <orig>Type</orig>
                        <translation>
                            <key>reportIndirectAssignments.archetypeNameColumn.label</key>
                        </translation>
                    </label>
                </display>
                <previousColumn>nameColumn</previousColumn>
                <export>
                    <expression>
                        <script>
                            <language>http://midpoint.evolveum.com/xml/ns/public/expression/language#mel</language>
                            <objectVariableMode>prismReference</objectVariableMode>
                            <code>
                                cel.bind(role, midpoint.resolveReferenceIfExists(object),
                                    !isPresent(role) ? nil : cel.bind(archetype, role.structuralArchetype(),
                                            isPresent(archetype) &amp;&amp; isPresent(archetype.name)
                                                ? archetype.name.orig : nil))
                            </code>
                        </script>
                    </expression>
                </export>
            </column>
            <column id="8">
                <name>relation</name>
                <display>
                    <label>
                        <orig>Relation</orig>
                        <translation>
                            <key>reportIndirectAssignments.relationColumn.label</key>
                        </translation>
                    </label>
                </display>
                <previousColumn>archetypeName</previousColumn>
                <export>
                    <expression>
                        <script>
                            <language>http://midpoint.evolveum.com/xml/ns/public/expression/language#mel</language>
                            <objectVariableMode>prismReference</objectVariableMode>
                            <code>isPresent(object) ? object.relation : nil</code>
                        </script>
                    </expression>
                </export>
            </column>
            <column id="9">
                <name>allPath</name>
                <display>
                    <label>
                        <orig>Path</orig>
                        <translation>
                            <key>reportIndirectAssignments.allPathColumn.label</key>
                        </translation>
                    </label>
                </display>
                <previousColumn>relation</previousColumn>
                <export>
                    <expression>
                        <script>
                            <language>http://midpoint.evolveum.com/xml/ns/public/expression/language#mel</language>
                            <objectVariableMode>prismReference</objectVariableMode>
                            <code>
                                !isPresent(data) ||
                                data.provenance.assignmentPath.segment.size() == 0
                                    ? '?' : cel.bind(path,
                                        data.provenance.assignmentPath.segment
                                            .map(segment, midpoint.resolveReferenceIfExists(segment.targetRef))
                                            .map(target, isPresent(target) &amp;&amp; isPresent(target.name)
                                                    ? stringify(target.name.orig, 'null') : 'null')
                                            .join(' -> '),
                                        path != '' ? path : '?')
                            </code>
                        </script>
                    </expression>
                </export>
            </column>
            <column id="10">
                <!-- This is probably not important column, everything is in the path column anyway. -->
                <name>parent</name>
                <display>
                    <label>
                        <orig>Parent</orig>
                        <translation>
                            <key>reportIndirectAssignments.parentColumn.label</key>
                        </translation>
                    </label>
                </display>
                <previousColumn>allPath</previousColumn>
                <export>
                    <expression>
                        <script>
                            <language>http://midpoint.evolveum.com/xml/ns/public/expression/language#mel</language>
                            <objectVariableMode>prismReference</objectVariableMode>
                            <code>
                                !isPresent(data) ||
                                data.provenance.assignmentPath.segment.size() == 0
                                    ? '?' : data.provenance.assignmentPath.segment.size() == 1
                                        ? 'Direct' : cel.bind(parent,
                                            midpoint.resolveReferenceIfExists(
                                                data.provenance.assignmentPath.segment[
                                                    data.provenance.assignmentPath.segment.size() - 2].targetRef),
                                            isPresent(parent) &amp;&amp; isPresent(parent.name)
                                                ? parent.name.orig : nil)
                            </code>
                        </script>
                    </expression>
                </export>
            </column>
            <column id="11">
                <!-- We don't store refs/metadata for disabled assignments, so this is always Enabled. -->
                <name>activation</name>
                <display>
                    <label>
                        <orig>Activation</orig>
                        <translation>
                            <key>reportIndirectAssignments.activationColumn.label</key>
                        </translation>
                    </label>
                </display>
                <previousColumn>parent</previousColumn>
                <export>
                    <expression>
                        <script>
                            <language>http://midpoint.evolveum.com/xml/ns/public/expression/language#mel</language>
                            <objectVariableMode>prismReference</objectVariableMode>
                            <code>
                                !isPresent(data) ? nil : cel.bind(path, data.provenance.assignmentPath,
                                        path.segment.size() == 0 ? nil : cel.bind(owner,
                                                midpoint.resolveReferenceIfExists(path.sourceRef),
                                                !isPresent(owner) ? nil : cel.bind(assignments,
                                                        owner.assignment.filter(assignment,
                                                            assignment.id == path.segment[0].assignmentId),
                                                        assignments.size() == 0 ||
                                                        !isPresent(assignments[0].activation) ? nil : assignments[0].activation.effectiveStatus)))
                            </code>
                        </script>
                    </expression>
                </export>
            </column>
            <column id="12">
                <name>validTo</name>
                <display>
                    <label>
                        <orig>Valid to</orig>
                        <translation>
                            <key>reportIndirectAssignments.validToColumn.label</key>
                        </translation>
                    </label>
                </display>
                <previousColumn>activation</previousColumn>
                <export>
                    <expression>
                        <script>
                            <language>http://midpoint.evolveum.com/xml/ns/public/expression/language#mel</language>
                            <objectVariableMode>prismReference</objectVariableMode>
                            <code>
                                !isPresent(data) ? nil : cel.bind(path, data.provenance.assignmentPath,
                                        path.segment.size() == 0 ? nil : cel.bind(owner,
                                                midpoint.resolveReferenceIfExists(path.sourceRef),
                                                !isPresent(owner) ? nil : cel.bind(assignments,
                                                        owner.assignment.filter(assignment,
                                                            assignment.id == path.segment[0].assignmentId),
                                                        assignments.size() == 0 ||
                                                        !isPresent(assignments[0].activation) ? nil : assignments[0].activation.validTo)))
                            </code>
                        </script>
                    </expression>
                </export>
            </column>
            <column id="13">
                <name>since</name>
                <display>
                    <label>
                        <orig>Since</orig>
                        <translation>
                            <key>reportIndirectAssignments.sinceColumn.label</key>
                        </translation>
                    </label>
                </display>
                <previousColumn>validTo</previousColumn>
                <export>
                    <expression>
                        <script>
                            <language>http://midpoint.evolveum.com/xml/ns/public/expression/language#mel</language>
                            <objectVariableMode>prismReference</objectVariableMode>
                            <code>
                                isPresent(data) &amp;&amp; isPresent(data.storage)
                                    ? data.storage.createTimestamp : nil
                            </code>
                        </script>
                    </expression>
                </export>
            </column>
            <column id="14">
                <name>createChannel</name>
                <display>
                    <label>
                        <orig>Source</orig>
                        <translation>
                            <key>reportIndirectAssignments.createChannelColumn.label</key>
                        </translation>
                    </label>
                </display>
                <previousColumn>since</previousColumn>
                <export>
                    <expression>
                        <script>
                            <language>http://midpoint.evolveum.com/xml/ns/public/expression/language#mel</language>
                            <objectVariableMode>prismReference</objectVariableMode>
                            <code>
                                !isPresent(data) ? nil : cel.bind(path, data.provenance.assignmentPath,
                                        path.segment.size() == 0 ? nil : cel.bind(owner,
                                                midpoint.resolveReferenceIfExists(path.sourceRef),
                                                !isPresent(owner) ? nil : cel.bind(assignments,
                                                        owner.assignment.filter(assignment,
                                                            assignment.id == path.segment[0].assignmentId),
                                                        assignments.size() == 0 ||
                                                        !isPresent(assignments[0].metadata) ||
                                                        !isPresent(assignments[0].metadata.createChannel)
                                                            ? nil : cel.bind(channel,
                                                                assignments[0].metadata.createChannel,
                                                                cel.bind(parts, channel.split('#'),
                                                                    midpoint.translateKeyInCurrentLocale(
                                                                        'Channel.' + parts[parts.size() - 1]))))))
                            </code>
                        </script>
                    </expression>
                </export>
            </column>
        </view>
    </objectCollection>
</report>
