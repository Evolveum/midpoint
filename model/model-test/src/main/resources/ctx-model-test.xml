<beans xmlns="http://www.springframework.org/schema/beans"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:context="http://www.springframework.org/schema/context"
        xsi:schemaLocation="http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
            http://www.springframework.org/schema/context
            http://www.springframework.org/schema/context/spring-context-3.0.xsd"
        default-lazy-init="false">

    <!-- enabling annotation driven configuration -->
    <context:annotation-config/>
    <context:component-scan base-package="com.evolveum.midpoint.model.test"/>
    <context:spring-configured/>

    <!--
        CorrelationCaseManagerImpl is not picked up by the component scan (the cases-impl package is scanned
        only by the full cases context, which is not used here). It is needed by MidpointFunctionsImpl. We don't want
        to import whole cases context here to not slow down the initialization process unnecessarily.
    -->
    <bean id="correlationCaseManager" class="com.evolveum.midpoint.cases.impl.CorrelationCaseManagerImpl"/>
</beans>
