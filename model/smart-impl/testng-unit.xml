            <class name="com.evolveum.midpoint.smart.impl.wellknownschemas.ldap.GroupOfNamesLdapMappingProviderTest"/>
            <class name="com.evolveum.midpoint.smart.impl.wellknownschemas.ldap.InetOrgPersonLdapMappingProviderTest"/>
            <class name="com.evolveum.midpoint.smart.impl.wellknownschemas.ldap.OrganizationalUnitLdapMappingProviderTest"/>
        </classes>
