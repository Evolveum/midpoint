        <classes>
            <class name="com.evolveum.midpoint.smart.impl.conndev.ConndevDocumentationServiceTest"/>
            <class name="com.evolveum.midpoint.smart.impl.conndev.ConnectorManifestReaderTest"/>
            <class name="com.evolveum.midpoint.smart.impl.conndev.ConnectorManifestWriterTest"/>
            <class name="com.evolveum.midpoint.smart.impl.conndev.ConnectorVersionUtilTest"/>
            <class name="com.evolveum.midpoint.smart.impl.conndev.DevSchemaObjectClassParserTest"/>
            <class name="com.evolveum.midpoint.smart.impl.conndev.ServiceClientJobMonitoringTest"/>
            <class name="com.evolveum.midpoint.smart.impl.conndev.ServiceClientTest"/>
        </classes>
    </test>
    <test name="Mappings" preserve-order="true" parallel="none" verbose="10">
        <classes>
            <class name="com.evolveum.midpoint.smart.impl.scoring.MappingScriptValidatorTest"/>
            <class name="com.evolveum.midpoint.smart.impl.mappings.heuristics.LowerCaseAndStripDiacriticsHeuristicTest"/>
            <class name="com.evolveum.midpoint.smart.impl.mappings.heuristics.StripDiacriticsHeuristicTest"/>
            <class name="com.evolveum.midpoint.smart.impl.mappings.heuristics.ToLowerCaseHeuristicTest"/>
