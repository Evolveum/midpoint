            <class name="com.evolveum.midpoint.smart.impl.mappings.heuristics.TrimLowerCaseAndStripDiacriticsHeuristicTest"/>
            <class name="com.evolveum.midpoint.smart.impl.mappings.heuristics.TrimUpperCaseAndStripDiacriticsHeuristicTest"/>
            <class name="com.evolveum.midpoint.smart.impl.mappings.heuristics.UpperCaseAndStripDiacriticsHeuristicTest"/>
        </classes>
