            <class name="com.evolveum.midpoint.smart.impl.mappings.heuristics.TrimAndStripDiacriticsHeuristicTest"/>
            <class name="com.evolveum.midpoint.smart.impl.mappings.heuristics.TrimAndUpperCaseHeuristicTest"/>
