<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="integration" parallel="none">
    <listeners>
        <listener class-name="com.evolveum.midpoint.tools.testng.AlphabeticalMethodInterceptor"/>
    </listeners>
    <test name="Tasks" preserve-order="true" parallel="none" verbose="10">
        <classes>
            <class name="com.evolveum.midpoint.model.intest.tasks.TestThresholdsMultiNode"/>
            <class name="com.evolveum.midpoint.model.intest.tasks.TestThresholdsSingleTaskMultipleThreads"/>
            <class name="com.evolveum.midpoint.model.intest.tasks.TestThresholdsSingleThread"/>
            <class name="com.evolveum.midpoint.model.intest.tasks.TestFocusPolicyInActivity"/>
            <class name="com.evolveum.midpoint.model.intest.tasks.TestFocusPolicyInParentActivity"/>
            <class name="com.evolveum.midpoint.model.intest.tasks.TestVirtualAssignmentInActivity"/>
            <class name="com.evolveum.midpoint.model.intest.tasks.TestTasks"/>

            <class name="com.evolveum.midpoint.model.intest.tasks.TestFocusPolicyContribution"/>
            <class name="com.evolveum.midpoint.model.intest.tasks.TestFocusPolicyActions"/>
            <class name="com.evolveum.midpoint.model.intest.tasks.TestFocusPolicyActionsComposite"/>
            <class name="com.evolveum.midpoint.model.intest.tasks.TestFocusPolicyActionsMultiNode"/>

            <class name="com.evolveum.midpoint.model.intest.tasks.TestFocusPolicyCombinations"/>

            <class name="com.evolveum.midpoint.model.intest.tasks.TestActivityPolicyNonIterativeScripting"/>

            <class name="com.evolveum.midpoint.model.intest.tasks.TestFocusPolicyHrScenarioSimple"/>
            <class name="com.evolveum.midpoint.model.intest.tasks.TestFocusPolicyHrScenarioMultithreaded"/>
            <class name="com.evolveum.midpoint.model.intest.tasks.TestFocusPolicyHrScenarioMultiTask"/>

            <class name="com.evolveum.midpoint.model.intest.tasks.TestCustomPolicyReconciliationMultiNode"/>
            <class name="com.evolveum.midpoint.model.intest.tasks.TestFocusPolicyTreeCounters"/>

            <class name="com.evolveum.midpoint.model.intest.tasks.TestActivityPolicyNonIterativeScripting"/>
            <class name="com.evolveum.midpoint.model.intest.tasks.TestActivityPolicyProcessing"/>
        </classes>
    </test>
</suite>
