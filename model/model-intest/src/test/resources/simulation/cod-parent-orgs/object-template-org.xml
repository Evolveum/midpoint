<objectTemplate xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
        xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
        oid="b5c3b7f2-5a8c-4a2e-9b0f-6a0f2b8c3e01">
    <name>org template (CoD parent + getParentOrgs)</name>
    <mapping>
        <documentation>
            Assigns a parent org whose identifier is in `description` (create on demand).
            A colon-separated path (e.g. "top:parent") creates the parents recursively.
        </documentation>
        <source>
            <path>description</path>
        </source>
        <expression>
            <assignmentTargetSearch>
                <targetType>OrgType</targetType>
                <filter>
                    <q:equal>
                        <q:path>identifier</q:path>
                        <expression>
                            <script>
                                <code>description.split(':').last()</code>
                            </script>
                        </expression>
                    </q:equal>
                </filter>
                <createOnDemand>true</createOnDemand>
                <populateObject>
                    <populateItem>
                        <expression>
                            <script>
                                <code>description.split(':').last()</code>
                            </script>
                        </expression>
                        <target>
                            <path>name</path>
                        </target>
                    </populateItem>
                    <populateItem>
                        <expression>
                            <script>
                                <code>description.split(':').last()</code>
                            </script>
                        </expression>
                        <target>
                            <path>identifier</path>
                        </target>
                    </populateItem>
                    <populateItem>
                        <expression>
                            <script>
                                <code>
                                    def index = description.lastIndexOf(':')
                                    index &lt; 0 ? null : description.substring(0, index)
                                </code>
                            </script>
                        </expression>
                        <target>
                            <path>description</path>
                        </target>
                    </populateItem>
                </populateObject>
            </assignmentTargetSearch>
        </expression>
        <target>
            <path>assignment</path>
        </target>
        <condition>
            <script>
                <code>description != null</code>
            </script>
        </condition>
    </mapping>
    <mapping>
        <documentation>
            Calls midpoint.getParentOrgs() on the org itself. In 4.8 preview mode, the parent org is created
            on demand only "virtually", so the parentOrgRef has no OID.
        </documentation>
        <source>
            <path>parentOrgRef</path>
        </source>
        <expression>
            <script>
                <code>
                    if (focus == null) {
                        return null
                    }
                    midpoint.getParentOrgs(focus).collect { 'parent:' + it.name?.orig }.join(',')
                </code>
            </script>
        </expression>
        <target>
            <path>costCenter</path>
        </target>
        <evaluationPhase>afterAssignments</evaluationPhase>
    </mapping>
    <mapping>
        <documentation>
            Walks up the hierarchy with midpoint.getParentOrgs() and writes all the ancestors to displayName.
        </documentation>
        <expression>
            <script>
                <code>
                    if (focus == null) {
                        return null
                    }
                    def names = []
                    def current = focus
                    for (int i = 0; i &lt; 10; i++) {
                        def parents = midpoint.getParentOrgs(current)
                        if (parents.isEmpty()) {
                            break
                        }
                        names.add(parents[0].name?.orig)
                        current = parents[0]
                    }
                    names.isEmpty() ? null : 'ancestors:' + names.join(',')
                </code>
            </script>
        </expression>
        <target>
            <path>displayName</path>
        </target>
        <evaluationPhase>afterAssignments</evaluationPhase>
    </mapping>
    <mapping>
        <documentation>
            Assigns a role that is created on demand. Used only for orgs whose identifier starts with "with-role-".
        </documentation>
        <source>
            <path>identifier</path>
        </source>
        <expression>
            <assignmentTargetSearch>
                <targetType>RoleType</targetType>
                <filter>
                    <q:equal>
                        <q:path>identifier</q:path>
                        <expression>
                            <script>
                                <code>'role-' + identifier</code>
                            </script>
                        </expression>
                    </q:equal>
                </filter>
                <createOnDemand>true</createOnDemand>
                <populateObject>
                    <populateItem>
                        <expression>
                            <script>
                                <code>'role-' + identifier</code>
                            </script>
                        </expression>
                        <target>
                            <path>name</path>
                        </target>
                    </populateItem>
                    <populateItem>
                        <expression>
                            <script>
                                <code>'role-' + identifier</code>
                            </script>
                        </expression>
                        <target>
                            <path>identifier</path>
                        </target>
                    </populateItem>
                </populateObject>
            </assignmentTargetSearch>
        </expression>
        <target>
            <path>assignment</path>
        </target>
        <condition>
            <script>
                <code>identifier != null &amp;&amp; identifier.startsWith('with-role-')</code>
            </script>
        </condition>
    </mapping>
</objectTemplate>
