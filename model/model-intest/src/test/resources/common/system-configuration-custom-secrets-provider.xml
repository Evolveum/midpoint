<!--
  Custom secrets provider whose own configuration contains a protected string
  that is resolved through another (file based) secrets provider.
  Only the secretsProviders part is used by tests, the custom provider is added
  to the running system configuration at runtime.
  -->
<systemConfiguration xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
        xmlns:my="http://midpoint.evolveum.com/xml/ns/public/custom/custom-3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:t="http://prism.evolveum.com/xml/ns/public/types-3">

    <secretsProviders>
        <!--
            'file-provider' provider already exists in system configuration used in test.
            This custom provider will be added to existing system configuration for the duration of the test.
        -->
        <custom>
            <identifier>custom-provider</identifier>
            <className>com.evolveum.midpoint.model.intest.MyCustomSecretsProvider</className>
            <configuration>
                <my:customProtectedStringConfigurationAttribute xsi:type="t:ProtectedStringType">
                    <t:externalData>
                        <!-- file-provider is defined in common/system-configuration.xml -->
                        <t:provider>file-provider</t:provider>
                        <t:key>file-secret</t:key>
                    </t:externalData>
                </my:customProtectedStringConfigurationAttribute>
            </configuration>
        </custom>
    </secretsProviders>
</systemConfiguration>
