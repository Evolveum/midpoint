<!-- User template with attempt variable used directly in property mapping -->

<objectTemplate oid="10000000-0000-0000-0000-0000000d1011"
   xmlns='http://midpoint.evolveum.com/xml/ns/public/common/common-3'>
    <name>user-template-iteration-attempt-mapping</name>
    <iterationSpecification>
        <maxIterations>5</maxIterations>
    </iterationSpecification>
    <mapping>
        <source>
            <path>givenName</path>
        </source>
        <source>
            <path>familyName</path>
        </source>
        <expression>
            <script>
                <code>
                    basic.concatName(givenName, familyName) + (attempt == 0 ? '' : '_' + attempt)
                </code>
             </script>
        </expression>
        <target>
            <path>name</path>
        </target>
    </mapping>
</objectTemplate>
