<!-- User template with maxIterations=10, start=1, useTokenOnlyOnConflict=true -->

<objectTemplate oid="10000000-0000-0000-0000-0000000d1007"
   xmlns='http://midpoint.evolveum.com/xml/ns/public/common/common-3'>
    <name>user-template-token-conflict-maxiter10-start1-true</name>
    <iterationSpecification>
        <start>1</start>
        <maxIterations>10</maxIterations>
        <useTokenOnlyOnConflict>true</useTokenOnlyOnConflict>
    </iterationSpecification>
    <mapping>
        <source>
            <path>givenName</path>
        </source>
        <source>
            <path>familyName</path>
        </source>
        <expression>
            <script>
                <code>
                    basic.concatName(givenName, familyName) + iterationToken
                </code>
             </script>
        </expression>
        <target>
            <path>name</path>
        </target>
    </mapping>
</objectTemplate>
