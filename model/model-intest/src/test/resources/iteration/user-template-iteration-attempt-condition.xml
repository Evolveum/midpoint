<!-- User template with attempt variable used in preIterationCondition -->

<objectTemplate oid="10000000-0000-0000-0000-0000000d1012"
   xmlns='http://midpoint.evolveum.com/xml/ns/public/common/common-3'>
    <name>user-template-iteration-attempt-condition</name>
    <iterationSpecification>
        <maxIterations>5</maxIterations>
        <tokenExpression>
            <script>
                <code>
                    if (attempt == 0) {
                        return "";
                    } else {
                        return "." + attempt;
                    }
                </code>
            </script>
        </tokenExpression>
        <preIterationCondition>
            <script>
                <code>attempt != 1</code>
            </script>
        </preIterationCondition>
    </iterationSpecification>
    <mapping>
        <source>
            <path>givenName</path>
        </source>
        <source>
            <path>familyName</path>
        </source>
        <expression>
            <script>
                <code>
                    basic.concatName(givenName, familyName) + iterationToken
                </code>
             </script>
        </expression>
        <target>
            <path>name</path>
        </target>
    </mapping>
</objectTemplate>
