<!-- User template with start=2, end=10, useTokenOnlyOnConflict=false -->

<objectTemplate oid="10000000-0000-0000-0000-0000000d1004"
   xmlns='http://midpoint.evolveum.com/xml/ns/public/common/common-3'>
    <name>user-template-token-conflict-start2-end10-false</name>
    <iterationSpecification>
        <start>2</start>
        <end>10</end>
        <useTokenOnlyOnConflict>false</useTokenOnlyOnConflict>
    </iterationSpecification>
    <mapping>
        <source>
            <path>givenName</path>
        </source>
        <source>
            <path>familyName</path>
        </source>
        <expression>
            <script>
                <code>
                    basic.concatName(givenName, familyName) + iterationToken
                </code>
             </script>
        </expression>
        <target>
            <path>name</path>
        </target>
    </mapping>
</objectTemplate>
