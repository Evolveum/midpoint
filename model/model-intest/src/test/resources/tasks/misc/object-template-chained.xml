<!--
  User template with chained mappings: the target of the first mapping (fullName) is the source of the second one.
  Both items exist in UserType only (not in AssignmentHolderType). See issue 12679.
-->
<objectTemplate xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
        oid="360b7cff-8a3b-467a-830b-1393e5906876">
    <name>object-template-chained</name>
    <mapping>
        <name>generate-fullname</name>
        <strength>strong</strength>
        <source>
            <path>givenName</path>
        </source>
        <source>
            <path>familyName</path>
        </source>
        <expression>
            <script>
                <language>mel</language>
                <code>
                    givenName + ' ' + familyName
                </code>
            </script>
        </expression>
        <target>
            <path>fullName</path>
        </target>
    </mapping>
    <mapping>
        <name>generate-display-name</name>
        <strength>strong</strength>
        <source>
            <path>fullName</path>
        </source>
        <target>
            <path>displayName</path>
        </target>
    </mapping>
</objectTemplate>
