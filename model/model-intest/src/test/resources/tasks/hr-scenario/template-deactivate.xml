<!-- Deactivates the user by setting validTo three hours into the past (from issue 11051). -->
<objectTemplate xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
        oid="0d1a0000-0000-0000-0000-000000000001">
    <name>template-deactivate</name>
    <mapping>
        <name>exitDate</name>
        <strength>strong</strength>
        <expression>
            <script>
                <code>
                    import com.evolveum.midpoint.prism.xml.XmlTypeConverter

                    return XmlTypeConverter.createXMLGregorianCalendar(System.currentTimeMillis() - 3 * 3600 * 1000L)
                </code>
            </script>
        </expression>
        <target>
            <path>activation/validTo</path>
        </target>
    </mapping>
</objectTemplate>
