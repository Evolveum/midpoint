                <order>2</order>
                <identifier>beta</identifier>
                <work>
                    <import>
                        <resourceObjects>
                            <resourceRef oid="c1a70000-0000-0000-0000-000000000002"/>
                            <kind>account</kind>
                            <intent>default</intent>
                        </resourceObjects>
                    </import>
                </work>
            </activity>
        </composition>
