<!-- User recompute that will skip a child activity on policy triggered. -->
<task xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
        xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
        oid="64118b9f-fd06-46da-b9a9-f6f6ae1b999f">
    <name>task-200-recompute-inline</name>
    <ownerRef oid="00000000-0000-0000-0000-000000000002" type="UserType"/>
    <executionState>closed</executionState>
    <activity>
        <composition>
            <activity>
                <order>1</order>
                <identifier>first</identifier>
                <work>
                    <noOp/>
                </work>
            </activity>
            <activity>
                <order>2</order>
                <identifier>second</identifier>
                <composition>
                    <activity>
                        <order>1</order>
                        <identifier>1</identifier>
                        <work>
                            <noOp/>
                        </work>
                    </activity>
                    <activity>
                        <order>2</order>
                        <identifier>2</identifier>
                        <work>
                            <recomputation>
                                <objects>
                                    <type>UserType</type>
                                    <query>
                                        <q:filter>
                                            <q:text>name = "administrator"</q:text>
                                        </q:filter>
                                    </query>
                                </objects>
                            </recomputation>
                        </work>
                    </activity>
                    <activity>
                        <order>3</order>
                        <identifier>3</identifier>
                        <work>
                            <noOp/>
                        </work>
                    </activity>
                </composition>
                <policies>
                    <policy>
                        <policyConstraints>
                            <alwaysTrue/>
                        </policyConstraints>
                        <policyActions>
                            <skipActivity/>
                        </policyActions>
                    </policy>
                </policies>
            </activity>
            <activity>
                <order>3</order>
                <identifier>third</identifier>
                <work>
                    <noOp/>
                </work>
            </activity>
        </composition>
        <distribution>
            <subtasks/> <!-- to complicate things a bit -->
        </distribution>
    </activity>
</task>
