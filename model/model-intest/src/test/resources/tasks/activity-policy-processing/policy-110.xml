<!-- Policy object carrying the suspend-on-errors rule, referenced via policyRef from task-110. -->
<policy oid="b7f1e230-5c3d-4d21-9a4e-0d5c1a2b0002"
        xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3">
    <name>policy-110</name>
    <inducement id="1">
        <policyRule>
            <name>ref-suspend-on-errors</name>
            <policyConstraints>
                <itemProcessingResult>
                    <status>fatal_error</status>
                </itemProcessingResult>
            </policyConstraints>
            <policyThreshold>
                <lowWaterMark>
                    <count>2</count>
                </lowWaterMark>
            </policyThreshold>
            <policyActions>
                <suspendTask/>
            </policyActions>
        </policyRule>
    </inducement>
</policy>
