<!--
    Import guarded by an inline focus policy: suspend after 3 user adds.
    Used to test the recovery by clearing policy states and counters.
-->
<task xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
        oid="b7f1e230-5c3d-4d21-9a4e-0d5c1a2b0130">
    <name>task-130-recover-inline</name>
    <ownerRef oid="00000000-0000-0000-0000-000000000002" type="UserType"/>
    <executionState>runnable</executionState>
    <activity>
        <work>
            <import>
                <resourceObjects>
                    <resourceRef oid="b7f1e230-5c3d-4d21-9a4e-0d5c1a2b0001" type="ResourceType"/>
                    <kind>account</kind>
                    <intent>default</intent>
                </resourceObjects>
            </import>
        </work>
        <policies>
            <policy>
                <name>inline-add-3</name>
                <policyConstraints>
                    <modification>
                        <operation>add</operation>
                    </modification>
                </policyConstraints>
                <policyThreshold>
                    <lowWaterMark>
                        <count>3</count>
                    </lowWaterMark>
                </policyThreshold>
                <policyActions>
                    <suspendTask/>
                </policyActions>
            </policy>
        </policies>
    </activity>
</task>
