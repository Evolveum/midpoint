<task xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
        xmlns:s="http://midpoint.evolveum.com/xml/ns/public/model/scripting-3"
        oid="d5c0d175-ebda-4506-821d-6205eeae85cf">
    <name>Non-iterative scripting restarted on execution time, suspended on attempts</name>
    <ownerRef oid="00000000-0000-0000-0000-000000000002" type="UserType"/>
    <executionState>runnable</executionState>
    <activity>
        <work>
            <nonIterativeScripting>
                <scriptExecutionRequest>
                    <s:execute>
                        <s:forWholeInput>true</s:forWholeInput>
                        <s:script>
                            <code>
                                import com.evolveum.midpoint.repo.common.activity.policy.ActivityPolicyProcessorHelper
                                import com.evolveum.midpoint.schema.result.OperationResult

                                for (int i = 0; i &lt; 10; i++) {
                                    log.info("Non-iterative scripting iteration {}", i)

                                    ActivityPolicyProcessorHelper.evaluateAndEnforceRules(
                                            null, new OperationResult("evaluateAndEnforceRules"))

                                    Thread.sleep(500)
                                }
                            </code>
                        </s:script>
                    </s:execute>
                </scriptExecutionRequest>
            </nonIterativeScripting>
        </work>
        <policies>
            <policy>
                <name>Limit restarts</name>
                <policyConstraints>
                    <executionAttempts>
                        <exceeds>2</exceeds>
                    </executionAttempts>
                </policyConstraints>
                <policyActions>
                    <suspendTask/>
                </policyActions>
                <order>10</order>
            </policy>
            <policy>
                <name>Max. 3s execution</name>
                <policyConstraints>
                    <executionTime>
                        <exceeds>PT3S</exceeds>
                    </executionTime>
                </policyConstraints>
                <policyActions>
                    <restartActivity>
                        <delay>PT1S</delay>
                    </restartActivity>
                </policyActions>
                <order>20</order>
            </policy>
        </policies>
    </activity>
</task>
