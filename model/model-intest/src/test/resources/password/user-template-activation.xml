<!-- Template with a mapping that always produces a change of the user, used to check that the account activation
     done by the user survives the consequences that the clockwork derives for the user. -->
<objectTemplate oid="5490aaaa-0000-0000-0000-000000000099"
        xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3">
    <name>user-template-activation</name>
    <mapping>
        <name>description-touched-by-template</name>
        <strength>strong</strength>
        <expression>
            <script>
                <code>'template run ' + System.currentTimeMillis()</code>
            </script>
        </expression>
        <target>
            <path>description</path>
        </target>
    </mapping>
</objectTemplate>
