<valuePolicy xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3">
    <name>Testing Dictionary Password Policy</name>
    <stringPolicy>
        <limitations>
            <checkAgainstDictionary>true</checkAgainstDictionary>
            <limit>
                <description>Alphanumeric characters</description>
                <characterClass>
                    <value>abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789</value>
                </characterClass>
            </limit>
        </limitations>
    </stringPolicy>
</valuePolicy>
